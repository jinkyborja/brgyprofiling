{
  "name": "brgy-profiling-sveltekit",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "preview": "node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/password.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "mysql2": "^3.14.4"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.2",
    "@sveltejs/kit": "^3.1.1",
    "@types/node": "^24.10.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.4.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  }
}
